  "cards": [
    { "dot": "cyan", "title": "Read path", "items": [
      "Findings are derived from claims on every read and never stored",
      "Only the human decision persists, in finding_states, keyed by fingerprint",
      "Brief, Decisions, Reporting and the Initiatives list share the same derive-and-merge path"
    ] },
    { "dot": "rose", "title": "Write path", "items": [
      "Every repository mutation calls assertWriteAllowed(); writes are off unless DEMO_WRITE_ENABLED=true outside Vercel previews",
      "Ownership is proven server-side; a finding fingerprint is re-derived by re-running the engine, never looked up",
      "Conflict decisions commit atomically: resolve_conflict RPC or writeStoreAtomic"
    ] },
    { "dot": "slate", "title": "Not in this revision", "items": [
      "No authentication, no AI extraction, no Jira or Drive integration",
      "GAP, UNKNOWN and RISK findings are not detected",
      "Pages also call getRepository() directly for initiative lookups"
    ] }
