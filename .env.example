# ─────────────────────────────────────────────────────────────────────────────
# Prodwise — environment configuration
#
# Copy to .env.local (gitignored) and fill in real values.
# With NO values set, the application still runs end to end against the
# in-repo local fixture repository. Nothing here is required for `npm run dev`.
# ─────────────────────────────────────────────────────────────────────────────

# ── Supabase (server-side only) ──────────────────────────────────────────────
# Deliberately NOT prefixed NEXT_PUBLIC_. These must never reach the browser.
# Prodwise ships no browser Supabase client; every read and write happens in a
# React Server Component or a server action.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=


# ── Phase 1 write safety ─────────────────────────────────────────────────────
# Phase 1 intentionally has no authentication. To make sure that does not leave
# an unrestricted public write surface, every mutation is gated by this flag,
# enforced server-side inside the repository layer — not merely hidden in the UI.
#
#   unset / false  →  reads work; create/update/delete fail safely with a clear,
#                     handled refusal (the default, and the safe posture for any
#                     shared or deployed environment)
#   true           →  mutations permitted; set this ONLY in the local/demo
#                     environment where you intend writes to be possible
#
# This is a temporary demo-security model. It is replaced by real authentication
# and permission-aware evidence access in a later phase. See CLAUDE.md §18.
DEMO_WRITE_ENABLED=false
