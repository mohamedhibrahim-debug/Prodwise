# Copy to ignored .env.local. All identity and provider values are server-only.
# Hosted mode fails closed; it never substitutes a demo signed-in actor.
AUTH_MODE=supabase
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
PRODWISE_WORKSPACE_ID=10000000-0000-4000-8000-000000000001
# Generate a private random secret of at least 32 characters.
AUTH_SESSION_SECRET=

# Environment restrictions are separate from current membership and role.
# Preview environments refuse business and management mutations.
DEMO_WRITE_ENABLED=false
MANAGEMENT_WRITE_ENABLED=false

# Claude may select and organize supported statements; humans must finalize.
# Both values are required. Use an available model ID from your Anthropic account.
# Without configuration, wording is clearly labelled template, not AI output.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

# Isolated single-machine fixture preview only:
# node scripts/auth/bootstrap-local.mjs generates private credentials and local env.
# AUTH_MODE=local is refused in production/hosted execution.
